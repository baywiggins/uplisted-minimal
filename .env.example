# Local development. Cloud profile is generated by the Azure deployment, not this file.
APP_ENV=local
MODEL_MODE=scripted
MODEL_PROVIDER=azure_openai
RENTCAST_MODE=fixture
AUTH_MODE=local_demo
CASE_ID=case-a
APP_ORIGIN=http://127.0.0.1:5173

# Local PostgreSQL only; never reuse these public development credentials in Azure.
DB_AUTH_MODE=local_password
PGHOST=127.0.0.1
PGPORT=5433
PGDATABASE=uplisted
PGUSER=uplisted_dev
PGPASSWORD=local-demo-only
PGSSLMODE=disable

# Azure OpenAI v1: actual resource endpoint and deployment name, not a catalog model name.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
# User-assigned workload identity in Azure; local development uses Azure CLI credentials.
AZURE_CLIENT_ID=
# Separate project endpoint for the Stage 18 managed-agent lab.
AZURE_AI_PROJECT_ENDPOINT=

# Required before explicitly enabled live requests / cloud or lab execution.
LIVE_MAX_RUN_USD=
LIVE_MAX_BATCH_USD=
LIVE_MAX_LAB_USD=
LIVE_MAX_INPUT_TOKENS=
LIVE_MAX_OUTPUT_TOKENS=
MODEL_RATES_FILE=

# Optional live RentCast: Key Vault reference in Azure, server environment only locally.
RENTCAST_API_KEY=
# Nonsecret telemetry endpoint/config set by infrastructure; content capture disabled.
APPLICATIONINSIGHTS_CONNECTION_STRING=
